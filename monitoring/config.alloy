// ============================================
// GLOBAL CONFIGURATION
// ============================================
logging {
  level = "info"
}

// ============================================
// TELEMETRY RECEIVER (Entry Point)
// ============================================
// OTLP receiver for traces and logs from Python application
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
    logs   = [otelcol.exporter.loki.default.input]
  }
}

// ============================================
// TRACES PIPELINE
// ============================================
// Forward traces to Tempo in LGTM stack
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "lgtm:4317"
    tls {
      insecure = true
    }
  }
}

// ============================================
// LOGS PIPELINE
// ============================================

// Convert OTLP logs to Loki format
otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

// Send logs to Loki
loki.write "default" {
  endpoint {
    url = "http://lgtm:3100/loki/api/v1/push"
  }
}

// ============================================
// METRICS PIPELINE ()
// ============================================
// Expose Alloy's own metrics
prometheus.exporter.self "alloy" {}

// Scrape Alloy's metrics
prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.prom.receiver]
}

// Send metrics to Prometheus
prometheus.remote_write "prom" {
  endpoint {
    url = "http://lgtm:9090/api/v1/write"
  }
}