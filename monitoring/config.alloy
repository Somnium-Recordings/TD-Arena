// NOTE: this can be reloaded without restarting the container
// 		 use: curl -X POST http://localhost:12345/-/reload


// ============================================
// GLOBAL CONFIGURATION
// ============================================
logging {
  level = "info"
}

// ============================================
// TELEMETRY RECEIVER (Entry Point)
// ============================================
// OTLP receiver for traces and logs from Python application
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  
  output {
    traces = [otelcol.exporter.otlp.default.input]
    logs   = [otelcol.processor.transform.promote_attributes.input]

  }
}

// ============================================
// TRACES PIPELINE
// ============================================

// ...

// ============================================
// LOGS PIPELINE
// ============================================

otelcol.processor.transform "promote_attributes" {
  error_mode = "ignore"

  log_statements {
    context = "log"
    statements = [
	  // Promote the source attribute to resource so we can index the label
	  // see monitoring/config.loki-config.yaml
	  // distributor.otlp_config.default_resource_attributes_as_index_labels
	// TODO: this is resulting in all logs having the same source
    //   `set(resource.attributes["source"], log.attributes["source"])`,
    //   `delete_key(log.attributes, "source")`,

	  // Remove attributes that we don't care about
      `delete_key(resource.attributes, "telemetry.sdk.name")`,
      `delete_key(resource.attributes, "telemetry.sdk.version")`,
      `delete_key(resource.attributes, "telemetry.sdk.language")`,
    ]
  }

  output {
    logs = [otelcol.exporter.otlp.default.input]
  }
}

// ============================================
// METRICS PIPELINE ()
// ============================================
// Expose Alloy's own metrics
prometheus.exporter.self "alloy" {}

// Scrape Alloy's metrics
prometheus.scrape "alloy" {
  targets    = prometheus.exporter.self.alloy.targets
  forward_to = [prometheus.remote_write.prom.receiver]
}

// ============================================
// Exporters
// ============================================
// Forward traces/logs to  OTEL grpc endpoint in LGTM stack
otelcol.exporter.otlp "default" {
  client {
    endpoint = "lgtm:4317"
    tls {
      insecure = true
    }
  }
}

// Send metrics to Prometheus
prometheus.remote_write "prom" {
  endpoint {
    url = "http://lgtm:9090/api/v1/write"
  }
}

// Send logs to alloy stdout
// otelcol.exporter.debug "logs" {
//   verbosity           = "detailed"
//   sampling_initial    = 1
//   sampling_thereafter = 1
// }